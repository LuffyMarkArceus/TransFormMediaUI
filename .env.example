# Clerk — copy from https://dashboard.clerk.com → API Keys
# Publishable key is public (shipped to the browser). Secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Backend. Leave unset to proxy through the Next.js /api rewrite,
# which reads BACKEND_URL (default http://localhost:8080 for dev).
NEXT_PUBLIC_BACKEND_URL=